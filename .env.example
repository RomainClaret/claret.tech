# claret.tech: environment variables
#
# Copy to .env.local (gitignored) and fill in what you use. Every variable
# below is read by the code; the comments give the default when unset.
#
# Privacy: no third-party tracking. The only analytics is Vercel Web
# Analytics (no cookies, disclosed in the privacy policy), on when deployed
# on Vercel. The site sets no cookies itself: the theme, high contrast and
# the privacy notice's dismissal are kept in localStorage. The error reports
# below are disclosed in the privacy policy too.

# ----------------------------------------
# GitHub (the Projects section)
# ----------------------------------------

# A token with read access to public repositories (scope public_repo):
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Whose repositories the server fetches (required when USE_GITHUB_DATA is
# "true"), and whose GitHub profile the page links to (default RomainClaret).
GH_USERNAME=YourGitHubUsername
NEXT_PUBLIC_GH_USERNAME=YourGitHubUsername

# "true" fetches live data from GitHub. Anything else fetches nothing, and
# Projects falls back to /profile.json, the snapshot the build took.
USE_GITHUB_DATA=true

# ----------------------------------------
# Publications (The Paper Trail, docs/publications.md)
# ----------------------------------------

# Whose publications /api/publications and scripts/fetch-publications.js
# look up. AUTHOR_NAME defaults to "Romain Claret".
SEMANTIC_SCHOLAR_AUTHOR_ID=
ORCID_ID=0000-0000-0000-0000
AUTHOR_NAME=Your Full Name

# The key for refreshing /api/publications' cache on demand, sent in the
# x-refresh-key header. Unset, refreshing on demand is off.
PUBLICATIONS_REFRESH_TOKEN=

# ----------------------------------------
# Blog
# ----------------------------------------

# The Medium account whose posts the blog lists, with or without the @
# (the code drops one: Medium's URLs carry their own). Default romainclaret.
NEXT_PUBLIC_MEDIUM_USERNAME=yourusername

# ----------------------------------------
# Error reports (src/app/api/client-error/route.ts)
# ----------------------------------------

# A fine-grained token with "Issues: Read and write" on this repository
# only: https://github.com/settings/personal-access-tokens/new
# With it, an error that stops a page becomes an issue labeled client-error
# (a recurrence, a comment). Unset, as in CI and local builds, the route
# files nothing and answers 204. Kept apart from GITHUB_TOKEN, which reads.
GITHUB_ISSUES_TOKEN=

# ----------------------------------------
# Site
# ----------------------------------------

# The site's address in robots.txt and the sitemap. Default
# https://claret.tech.
NEXT_PUBLIC_SITE_URL=https://claret.tech

# ----------------------------------------
# Development and tests
# ----------------------------------------

# "true" skips the Kudos and Medium scrapers, as CI's builds and tests do.
SKIP_EXTERNAL_APIS=false

# "true", at build and start, for a production build served over plain http
# (the e2e tests, docs/performance.md): the HTTPS-only headers otherwise
# blank the page in WebKit. Vercel serves https and never sets it.
SERVE_HTTP=false

# "true" writes a bundle report: ANALYZE=true npm run build
ANALYZE=false
