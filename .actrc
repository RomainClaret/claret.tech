# ACT Configuration for local GitHub Actions testing
# https://github.com/nektos/act

# The image act runs ubuntu-latest jobs in: Node 24 (package.json engines)
# with jq, gh and docker, as GitHub's runners have them. Build it first:
#   docker build --platform linux/amd64 -t claret-act:24 .github/act
--platform ubuntu-latest=claret-act:24

# A local image, which no registry has: act pulls images by default.
--pull=false

# Container architecture for Apple Silicon compatibility
--container-architecture linux/amd64

# Enable verbose output for debugging
# --verbose

# Reuse containers between runs for faster execution
--reuse

# Default secrets file location (create .env.act.local for testing)
--secret-file .env.act.local

# Custom event file location (optional)
# --eventpath .github/workflows/events/